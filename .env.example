# Modellzugang. Das Modell muss Bildeingabe und Function Calling beherrschen.
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=your-vision-capable-model
REASONING_EFFORT=medium

# Woher die Oberfläche den Motor aufrufen darf. Für einen Test vom Handy die
# LAN-Adresse ergänzen, sonst blockt der Browser die Anfragen.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Nur noch für das alte Dash-Frontend unter src/frontend relevant.
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_PORT=8050
